{
  // TypeScript compiler settings. `npm run typecheck` runs `tsc --noEmit`:
  // it checks types only; Next.js does the real compilation (its own compiler).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler", // resolve imports the way Next's bundler does
    "jsx": "react-jsx",
    "strict": true, // all strict checks: null safety, no implicit any, ...
    "noUncheckedIndexedAccess": true, // arr[i] is `T | undefined`: forces handling missing rows
    "noEmit": true,
    "allowJs": false,
    "skipLibCheck": true, // don't type-check node_modules' .d.ts files (speed)
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true, // every file must compile alone (required by Next/Vitest)
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      // `@/core/...` means `src/core/...` everywhere (app code, tests, eslint).
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "drizzle", "apps", "packages"] // apps/v2 has its own config (ADR-0056)
}
