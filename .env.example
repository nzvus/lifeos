# lifeos. Copy to .env.local; never commit it.

# One database, exactly one of the two:
#   Neon's branch `v2`, pooled URL (the developer creates it):
# DATABASE_URL=postgres://…-pooler…/lifeos_v2?sslmode=verify-full
#   (Neon writes sslmode=require: replace it with verify-full, docs/runbooks/setup.md §2)
#   or a PGlite folder on this machine (migrated on start, nobody else's):
V2_PGLITE_DIR=.pglite

# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Where the app runs locally (npm run dev serves :3200).
BETTER_AUTH_URL=http://localhost:3200
# "true" only while creating the account; then back to "false".
ALLOW_SIGNUP=false
