# .env.example — every environment variable the app reads, with no real values.
# Copy to `.env` for local development (`.env` is gitignored). On Vercel the
# same names are set in Project Settings -> Environment Variables; in GitHub
# Actions as repository secrets. Validated at startup by src/app/_server/env.ts.

# Postgres connection string. Locally: a Neon *development branch* (direct
# url is fine for one local process). On Vercel: Neon's POOLED url (host
# contains "-pooler").
# sslmode=verify-full: encrypt AND verify the server's certificate and name.
# Neon's own strings say sslmode=require; replace it. The pg driver treats
# `require` as verify-full today but will weaken it to "encrypt only" in its
# next major version (it prints a SECURITY WARNING about this).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=verify-full

# Random secret that signs session cookies. Generate: `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Public base URL of the app. Locally http://localhost:3000. On Vercel you may
# leave it unset: the app derives it from VERCEL_URL (see _server/env.ts).
BETTER_AUTH_URL=http://localhost:3000

# "true" only while you create your account, then set back to "false"
# (anyone who finds the URL could otherwise register — see ADR-0006 tripwire).
ALLOW_SIGNUP=false
